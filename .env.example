# Turso (libSQL). Leave unset to use a local SQLite file at ./data/papertrail.db.
TURSO_DATABASE_URL=libsql://papertrail-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=

# Public origin, used for absolute links in emails, the feed and Open Graph tags.
SITE_URL=http://localhost:3000

# Password for the Court of Claims clerk desk at /court/admin. Leave empty to disable it.
ADMIN_PASSWORD=

# Secret for signing confirm and unsubscribe links (at least 16 characters).
# Changing it invalidates every link already sent. Leave empty to disable subscriptions.
EMAIL_TOKEN_SECRET=

# Delivery provider for email. "console" prints messages instead of sending them.
EMAIL_PROVIDER=console
EMAIL_FROM="Paper Trail <ledger@example.com>"
